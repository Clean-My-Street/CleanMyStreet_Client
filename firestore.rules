rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow delete: if false;

      match /savedItems/{savedItemId} {
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
            'itemId',
            'type',
            'title',
            'detail',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'itemId',
            'type',
            'title',
            'detail',
            'createdAt'
          ])
          && request.resource.data.type in ['site', 'campaign']
          && request.resource.data.itemId is string
          && request.resource.data.title is string
          && request.resource.data.detail is string;
        allow update: if false;
      }

      // Created by the Cloud Function API. Owners may only flip `read`.
      match /notifications/{notificationId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Shared content is readable by signed-in users. All writes go through
    // the Cloud Function API, which uses the Admin SDK and bypasses these rules.
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /newsArticles/{articleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /contributions/{contributionId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
  }
}
