# Copy to functions/.env and fill in. Non-secret settings only.
#
# Ozow keys are secrets. Set them once per Firebase project with:
#   firebase functions:secrets:set OZOW_PRIVATE_KEY
#   firebase functions:secrets:set OZOW_API_KEY
# For the emulator, put them in functions/.secret.local (never commit it):
#   OZOW_PRIVATE_KEY=...
#   OZOW_API_KEY=...

# Site code from Ozow Merchant Admin.
OZOW_SITE_CODE=

# Payments stay in Ozow test mode unless this is exactly "false".
OZOW_IS_TEST=true

# Public URL of the api function, used for Ozow's notify and return URLs.
PUBLIC_API_URL=https://us-central1-cleanmystreetapp.cloudfunctions.net/api

# Comma-separated web origins the app is hosted on, which Ozow payments may
# return to (app deep links and localhost are always allowed).
ALLOWED_RETURN_ORIGINS=https://cleanmystreetapp.web.app,https://cleanmystreetapp.firebaseapp.com
